/* 全局基础样式：浅色、克制，沿用 M0 验证页的配色 */

page {
  background: #f6f6f4;
  color: #1f1f1d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.page {
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-t {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow { flex: 1; min-width: 0; }

.muted { color: #7a7a75; }
.tiny { font-size: 22rpx; }
.small { font-size: 24rpx; }
.strong { font-weight: 500; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mono { font-family: Menlo, Consolas, monospace; }

.amount { color: #0f6e56; font-weight: 500; }
.danger { color: #b42318; }
.warn { color: #b54708; }

.badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #e1f5ee;
  color: #0f6e56;
  margin-left: 10rpx;
}

.badge-grey { background: #ecece8; color: #6a6a65; }
.badge-warn { background: #fef0c7; color: #b54708; }

.btn {
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 16rpx 30rpx;
  text-align: center;
  line-height: 1.4;
  background: #0f6e56;
  color: #ffffff;
}

.btn-ghost { background: #e1f5ee; color: #0f6e56; }
.btn-grey { background: #ecece8; color: #4a4a46; }
.btn-danger { background: #fee4e2; color: #b42318; }
.btn-block { width: 100%; box-sizing: border-box; }
.btn-hover { opacity: 0.72; }

/*
 * 未连电脑时，需要电脑的操作置灰。写 .btn.btn-off 是为了压过
 * .btn / .btn-ghost 各自的背景色——「点了才知道发不出去」比置灰更烦人。
 * 原因由顶部状态条负责解释，这里不再加一行小字。
 */
.btn.btn-off { background: #e6e6e1; color: #a5a59e; }

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.btn-row .btn { margin-right: 16rpx; margin-bottom: 12rpx; }

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: #6a6a65;
  margin-bottom: 10rpx;
}

.input, .picker-box, .textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f6f6f4;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f1f1d;
  min-height: 76rpx;
}

.textarea { min-height: 140rpx; }

.divider {
  height: 1rpx;
  background: #ecece8;
  margin: 20rpx 0;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9a9a94;
  font-size: 26rpx;
  line-height: 1.8;
}

/* 分段控件、勾选行、行内文字按钮：多个页面共用，放全局避免各页复制一份 */

/* 传输页的方向切换：比 sort-bar 更重（实心按钮），避免和页面内的分段看成一个层级 */
.dir-bar {
  display: flex;
  margin-bottom: 20rpx;
}

.dir-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #3f3f3c;
  padding: 20rpx 0;
  margin-right: 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 2rpx solid #e6e6e0;
}

.dir-btn:last-child {
  margin-right: 0;
}

.dir-btn.on {
  background: #0f6e56;
  border-color: #0f6e56;
  color: #ffffff;
  font-weight: 500;
}

.sort-bar {
  display: flex;
  background: #ecece8;
  border-radius: 10rpx;
  padding: 6rpx;
}

.sort-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6a6a65;
  padding: 14rpx 0;
  border-radius: 8rpx;
}

.sort-btn.on {
  background: #ffffff;
  color: #0f6e56;
  font-weight: 500;
}

.pick-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ecece8;
}

.check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #c6c6c0;
  color: #ffffff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.check.on {
  background: #0f6e56;
  border-color: #0f6e56;
}

.link {
  font-size: 24rpx;
  color: #0f6e56;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
