/* 全局基础样式：浅色、克制，沿用 M0 验证页的配色 */

page {
  background: #f6f6f4;
  color: #1f1f1d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

.page {
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-t {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow { flex: 1; min-width: 0; }

.muted { color: #7a7a75; }
.tiny { font-size: 22rpx; }
.small { font-size: 24rpx; }
.strong { font-weight: 500; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mono { font-family: Menlo, Consolas, monospace; }

.amount { color: #0f6e56; font-weight: 500; }
.danger { color: #b42318; }
.warn { color: #b54708; }

.badge {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #e1f5ee;
  color: #0f6e56;
  margin-left: 10rpx;
}

.badge-grey { background: #ecece8; color: #6a6a65; }
.badge-warn { background: #fef0c7; color: #b54708; }

.btn {
  font-size: 26rpx;
  border-radius: 10rpx;
  padding: 16rpx 30rpx;
  text-align: center;
  line-height: 1.4;
  background: #0f6e56;
  color: #ffffff;
}

.btn-ghost { background: #e1f5ee; color: #0f6e56; }
.btn-grey { background: #ecece8; color: #4a4a46; }
.btn-danger { background: #fee4e2; color: #b42318; }
.btn-block { width: 100%; box-sizing: border-box; }
.btn-hover { opacity: 0.72; }

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.btn-row .btn { margin-right: 16rpx; margin-bottom: 12rpx; }

.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: #6a6a65;
  margin-bottom: 10rpx;
}

.input, .picker-box, .textarea {
  width: 100%;
  box-sizing: border-box;
  background: #f6f6f4;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #1f1f1d;
  min-height: 76rpx;
}

.textarea { min-height: 140rpx; }

.divider {
  height: 1rpx;
  background: #ecece8;
  margin: 20rpx 0;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #9a9a94;
  font-size: 26rpx;
  line-height: 1.8;
}

/* 分段控件、勾选行、行内文字按钮：多个页面共用，放全局避免各页复制一份 */
.sort-bar {
  display: flex;
  background: #ecece8;
  border-radius: 10rpx;
  padding: 6rpx;
}

.sort-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6a6a65;
  padding: 14rpx 0;
  border-radius: 8rpx;
}

.sort-btn.on {
  background: #ffffff;
  color: #0f6e56;
  font-weight: 500;
}

.pick-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ecece8;
}

.check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #c6c6c0;
  color: #ffffff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.check.on {
  background: #0f6e56;
  border-color: #0f6e56;
}

.link {
  font-size: 24rpx;
  color: #0f6e56;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
