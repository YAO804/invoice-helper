.warn-card {
  background: #fef0c7;
  color: #b54708;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -6rpx 0;
}

.chip {
  font-size: 24rpx;
  color: #6a6a65;
  background: #ecece8;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin: 0 6rpx 12rpx;
}

.chip.on {
  background: #0f6e56;
  color: #ffffff;
}

.pick-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ecece8;
}

.check {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #c6c6c0;
  color: #ffffff;
  font-size: 24rpx;
  flex-shrink: 0;
}

.check.on {
  background: #0f6e56;
  border-color: #0f6e56;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
