<view class="page">

  <conn-bar status="{{status}}" base="{{baseText}}" />

  <view wx:if="{{status != 'ok'}}" class="card">
    <view class="row">
      <text class="card-t">{{status == 'fail' ? '连不上电脑' : '导出要用电脑端的数据'}}</text>
      <text class="badge badge-grey">{{status == 'checking' ? '正在连' : '未连接'}}</text>
    </view>
    <view wx:if="{{status == 'fail'}}" class="tiny muted" style="margin-top:10rpx">确认电脑端程序还开着、手机和电脑在同一个 Wi-Fi。当前地址 {{baseText}}。</view>
    <view wx:else class="tiny muted" style="margin-top:10rpx">台账只在电脑上，CSV 由电脑端生成。先连上电脑再来导出。</view>
    <view class="btn btn-block" style="margin-top:18rpx" bindtap="onConnect" hover-class="btn-hover">去连接电脑</view>
  </view>

  <block wx:if="{{status == 'ok'}}">
    <view class="card">
      <view class="card-t">导出范围</view>
      <view class="sort-bar" style="margin-top:16rpx">
        <view wx:for="{{scopes}}" wx:key="key" class="sort-btn {{item.on ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onScopeChange" hover-class="btn-hover">{{item.name}}</view>
      </view>
      <view class="row small" style="margin-top:20rpx">
        <text class="muted">发票</text>
        <text>{{loading ? '读取中…' : count + ' 张'}}</text>
      </view>
      <view class="row small" style="margin-top:12rpx">
        <text class="muted">价税合计</text>
        <text class="amount">¥{{amountText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="btn btn-block" bindtap="onExport" hover-class="btn-hover">{{exporting ? '正在导出…' : '导出 CSV 并转发'}}</view>
      <view class="tiny muted" style="margin-top:14rpx">文件由电脑端生成后下载到手机，再通过微信转发（可以发给「文件传输助手」存档）。CSV 带 UTF-8 BOM，Excel 可直接打开。</view>
    </view>
  </block>

  <view class="foot tiny muted">电脑端网页也能导出（支持当前筛选和勾选记录），数据量大时用电脑更顺手。</view>

</view>
