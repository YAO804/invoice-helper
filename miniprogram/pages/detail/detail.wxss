/* 详情页：只读字段列表 + 重复组 */

.amount-xl {
  font-size: 44rpx;
  font-weight: 500;
  color: #0f6e56;
}

.right {
  text-align: right;
  word-break: break-all;
}

.kv {
  display: flex;
  align-items: baseline;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #ecece8;
}

.kv:last-child {
  border-bottom: none;
}

.kv .tiny.muted {
  flex: 0 0 140rpx;
}

.dup-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-top: 1rpx solid #ecece8;
}
