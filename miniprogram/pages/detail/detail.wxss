.amount-xl {
  font-size: 44rpx;
  font-weight: 500;
  color: #0f6e56;
}

.right {
  text-align: right;
  word-break: break-all;
}

.item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ecece8;
}

.item:last-child {
  border-bottom: none;
}

.meta-row {
  padding: 6rpx 0;
  align-items: flex-start;
}

.meta-row .muted {
  flex: 0 0 160rpx;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
