<view class="page" wx:if="{{item}}">

  <view class="card">
    <view class="row">
      <text class="small mono grow">{{item.number || '无号码'}}</text>
      <text wx:if="{{item.duplicate}}" class="badge badge-warn">重复</text>
      <text wx:if="{{item.needFill}}" class="badge badge-grey">待补录</text>
    </view>
    <view class="tiny muted" style="margin-top:8rpx">{{item.kind || '票种待补'}}</view>
    <view class="amount-xl" style="margin-top:16rpx">{{item.amount ? '¥' + item.amount : '金额待补'}}</view>
  </view>

  <view class="card">
    <view class="kv" data-value="{{item.number}}" bindtap="onCopy" hover-class="btn-hover">
      <text class="tiny muted">发票号码</text>
      <text class="small mono grow right">{{item.number || '—'}}</text>
    </view>
    <view class="kv" data-value="{{item.code}}" bindtap="onCopy" hover-class="btn-hover">
      <text class="tiny muted">发票代码</text>
      <text class="small mono grow right">{{item.code || '—'}}</text>
    </view>
    <view class="kv">
      <text class="tiny muted">票种</text>
      <text class="small grow right">{{item.kind || '—'}}</text>
    </view>
    <view class="kv">
      <text class="tiny muted">开票日期</text>
      <text class="small grow right">{{item.issueDate || '—'}}</text>
    </view>
    <view class="kv">
      <text class="tiny muted">价税合计</text>
      <text class="small grow right">{{item.amount || '—'}}</text>
    </view>
    <view class="kv">
      <text class="tiny muted">报销人</text>
      <text class="small grow right {{item.reimburser ? '' : 'warn'}}">{{item.reimburser || '待补录'}}</text>
    </view>
    <view class="kv">
      <text class="tiny muted">录入时间</text>
      <text class="small grow right">{{item.createdAt || '—'}}</text>
    </view>
  </view>

  <view wx:if="{{item.duplicate && groupMore}}" class="card">
    <view class="small strong warn" style="margin-bottom:4rpx">同一张票共录入 {{group.length}} 次</view>
    <view class="tiny muted" style="margin-bottom:12rpx">判重只看「发票代码 + 号码」，与金额、日期无关。留哪张由电脑端决定。</view>
    <view wx:for="{{group}}" wx:key="id" class="dup-row">
      <text class="tiny mono">{{item.code || '无代码'}} · {{item.number}}</text>
      <text class="tiny {{item.self ? 'amount' : 'muted'}}">{{item.self ? '当前' : '¥' + (item.total || '—')}}</text>
      <text class="tiny muted">{{item.createdAt}}</text>
    </view>
  </view>

  <view class="card">
    <view class="btn btn-ghost btn-block" bindtap="onCopy" data-value="{{item.number}}" hover-class="btn-hover">复制发票号码</view>
  </view>

  <view class="foot tiny muted">小程序只读。补录报销人、删除重复、修改字段请到电脑端台账页操作。</view>

</view>
