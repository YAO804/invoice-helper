<view class="page">

  <view wx:if="{{!connected}}" class="card empty-card">
    <view class="empty-t">台账在电脑上</view>
    <view class="empty-h">小程序不保存发票数据，台账由电脑端维护。连上电脑后这里会自动同步。</view>
    <view class="btn btn-block" style="margin-top:24rpx" bindtap="onConnect" hover-class="btn-hover">去连接电脑</view>
  </view>

  <block wx:else>
    <!-- 概览：一眼看清有多少、值多少；重复/待补录是筛选入口 -->
    <view class="card ov">
      <view class="ov-head">
        <view class="ov-main">
          <text class="ov-n">{{total}}</text>
          <text class="ov-u">张</text>
          <text class="ov-sep">·</text>
          <text class="ov-amt">¥{{amountText}}</text>
        </view>
        <text class="ov-sync">{{syncedText}}</text>
      </view>

      <view class="tags">
        <view class="tag {{onlyDuplicates ? 'on' : ''}}" bindtap="onToggleDuplicates" hover-class="btn-hover">
          <text>仅看重复</text>
          <text class="tag-n {{duplicateGroups ? 'warn' : ''}}">{{duplicateGroups}}</text>
        </view>
        <view class="tag {{onlyNeedFill ? 'on' : ''}}" bindtap="onToggleNeedFill" hover-class="btn-hover">
          <text>仅看待补录</text>
          <text class="tag-n {{needFill ? 'warn' : ''}}">{{needFill}}</text>
        </view>
      </view>

      <view class="ov-foot">
        <text class="base-text ellipsis">{{baseText}}</text>
        <text wx:if="{{hasFilter}}" class="link" bindtap="onReset">清空条件</text>
      </view>
    </view>

    <!-- 筛选：搜索 / 条件 pill / 排序，各占一行，不再堆在一个块里 -->
    <view class="card filters">
      <input class="search" placeholder="搜索号码 / 报销人 / 金额" placeholder-class="search-ph"
        value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" />

      <view class="pill-row">
        <view wx:if="{{latestCreatedAt}}" class="pill-slot">
          <view class="pill {{latestOn ? 'on' : ''}}" bindtap="onLatestCreated" hover-class="btn-hover">最近录入 {{latestCreatedAt}}</view>
        </view>
        <picker class="pill-slot" mode="date" value="{{createdFrom}}" bindchange="onCreatedFromChange">
          <view class="pill {{createdFrom ? 'on' : ''}}">{{fromText}}</view>
        </picker>
        <picker class="pill-slot" mode="date" value="{{createdTo}}" bindchange="onCreatedToChange">
          <view class="pill {{createdTo ? 'on' : ''}}">{{toText}}</view>
        </picker>
        <view wx:if="{{batchFilter}}" class="pill-slot">
          <view class="pill on" bindtap="onClearBatch" hover-class="btn-hover">刚发的那批 ✕</view>
        </view>
        <view wx:if="{{createdFrom || createdTo}}" class="pill-slot">
          <view class="pill grey" bindtap="onClearCreated" hover-class="btn-hover">清除日期</view>
        </view>
      </view>

      <view class="sort-bar">
        <view wx:for="{{sorts}}" wx:key="value" class="sort-btn {{item.on ? 'on' : ''}}" data-sort="{{item.value}}" bindtap="onSortChange" hover-class="btn-hover">{{item.short}}</view>
      </view>
    </view>

    <view wx:if="{{error}}" class="card error-card">
      <view class="empty-t danger">读不到电脑台账</view>
      <view class="empty-h">{{error}}</view>
      <view class="empty-h">检查电脑端是否在运行，或到「设置」重新连接。</view>
    </view>

    <view wx:for="{{items}}" wx:key="id"
      class="card inv {{item.duplicate ? 'is-dup' : ''}} {{item.needFill ? 'is-need' : ''}}"
      data-id="{{item.id}}" bindtap="onOpenDetail" hover-class="inv-hover">
      <view class="inv-top">
        <text class="inv-no mono ellipsis">{{item.number || '无号码'}}</text>
        <text class="inv-amt">{{item.amount ? '¥' + item.amount : '待补'}}</text>
      </view>
      <view class="inv-sub">
        <text class="sub-text ellipsis">{{item.kind || '票种待补'}} · 开票 {{item.issueDate || '待补'}}</text>
        <text wx:if="{{item.duplicate}}" class="badge badge-warn">重复</text>
      </view>
      <view class="inv-meta">
        <view class="who {{item.reimburser ? '' : 'who-need'}} ellipsis">{{item.reimburser || '报销人待补'}}</view>
        <text class="when">{{item.createdShort}}</text>
      </view>
    </view>

    <view wx:if="{{loading && !items.length}}" class="empty">正在读取电脑台账…</view>

    <view wx:if="{{!loading && !items.length && !error}}" class="card empty-card">
      <block wx:if="{{hasFilter}}">
        <view class="empty-t">没有匹配的发票</view>
        <view class="empty-h">换个关键词，或者清空筛选条件再看看。</view>
        <view class="btn btn-ghost btn-block" style="margin-top:24rpx" bindtap="onReset" hover-class="btn-hover">清空筛选条件</view>
      </block>
      <block wx:else>
        <view class="empty-t">台账还是空的</view>
        <view class="empty-h">到「收票」页扫码，或从微信里导入发票文件。</view>
        <view class="btn btn-block" style="margin-top:24rpx" bindtap="onCollect" hover-class="btn-hover">去收票</view>
      </block>
    </view>
  </block>

  <view class="foot tiny muted">台账只存在电脑端；补录、删除、改报销人请在电脑端网页操作。</view>

</view>
