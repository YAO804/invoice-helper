.sort-bar {
  background: #ecece8;
  border-radius: 10rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.sort-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #6a6a65;
  padding: 14rpx 0;
  border-radius: 8rpx;
}

.sort-btn.on {
  background: #ffffff;
  color: #0f6e56;
  font-weight: 500;
}

.summary {
  padding: 28rpx 30rpx;
}

.sum-amount {
  font-size: 62rpx;
  font-weight: 500;
  color: #0f6e56;
  line-height: 1.3;
  margin: 16rpx 0 12rpx;
}

.search {
  margin-top: 16rpx;
}

.invoice {
  padding: 24rpx 26rpx;
}

.amount-lg {
  font-size: 34rpx;
  font-weight: 500;
  color: #0f6e56;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
