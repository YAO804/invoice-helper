/* 台账页：统计条 + 筛选 + 只读卡片列表 */

.stats {
  display: flex;
  margin-top: 20rpx;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-n {
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1.4;
}

.filter-row {
  display: flex;
  align-items: center;
  margin: 20rpx 0 0;
}

/* 录入时间起止：两个日期选择器并排，和下面的条件 chip 分成两行 */
.date-row {
  display: flex;
  margin-top: 16rpx;
}

.date-slot {
  flex: 1;
  margin-right: 12rpx;
}

.date-slot:last-child {
  margin-right: 0;
}

.date-cell {
  font-size: 24rpx;
  color: #6a6a65;
  background: #f6f6f4;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  text-align: center;
}

.date-cell.on {
  color: #0f6e56;
  background: #e8f2ee;
  font-weight: 500;
}

.chip {
  font-size: 24rpx;
  color: #6a6a65;
  background: #ecece8;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
}

.chip.on {
  background: #0f6e56;
  color: #ffffff;
}

.filter-row .link {
  margin-left: auto;
}

.inv {
  padding: 24rpx 26rpx;
}

.amount-lg {
  font-size: 32rpx;
  font-weight: 500;
  color: #0f6e56;
  margin-left: 16rpx;
  flex-shrink: 0;
}
