<view class="page">

  <view class="card">
    <view class="card-t">{{isEdit ? '编辑发票' : '手动录入'}}</view>
    <view class="tiny muted" style="margin-top:8rpx">金额单位：元；只填价税合计也可以，勾稽提示会在详情页显示。</view>
  </view>

  <view wx:if="{{hint}}" class="card hint-card">
    <view class="small">{{hint}}</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">发票号码 *</view>
      <input class="input mono" placeholder="数电票 20 位" value="{{form.invoice_no}}" data-field="invoice_no" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">开票日期 *</view>
      <picker mode="date" value="{{form.issue_date}}" bindchange="onDateChange">
        <view class="picker-box">{{dateText}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">票种</view>
      <input class="input" placeholder="数电票 / 电子普通发票…" value="{{form.invoice_type}}" data-field="invoice_type" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">销方名称</view>
      <input class="input" placeholder="开票单位" value="{{form.seller_name}}" data-field="seller_name" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">销方税号</view>
      <input class="input mono" placeholder="统一社会信用代码" value="{{form.seller_tax_id}}" data-field="seller_tax_id" bindinput="onInput" />
    </view>

    <view class="field">
      <view class="field-label">买方名称</view>
      <input class="input" placeholder="个人抬头可写姓名" value="{{form.buyer_name}}" data-field="buyer_name" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">价税合计（元）</view>
      <input class="input" type="digit" placeholder="0.00" value="{{form.total}}" data-field="total" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">不含税金额（元）</view>
      <input class="input" type="digit" placeholder="0.00" value="{{form.excl}}" data-field="excl" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">税额（元）</view>
      <input class="input" type="digit" placeholder="0.00" value="{{form.tax}}" data-field="tax" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">税率</view>
      <input class="input" placeholder="如 0.06" value="{{form.tax_rate}}" data-field="tax_rate" bindinput="onInput" />
    </view>
    <view class="field" style="margin-bottom:0">
      <view class="field-label">备注</view>
      <textarea class="textarea" placeholder="选填" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <view class="card">
    <view class="btn btn-block" bindtap="onSave" hover-class="btn-hover">{{isEdit ? '保存修改' : '保存到台账'}}</view>
    <view class="btn btn-grey btn-block" style="margin-top:16rpx" bindtap="onCancel" hover-class="btn-hover">取消</view>
  </view>

  <view class="foot tiny muted">本工具不做发票查验，也不判定真伪。真伪以国家税务总局查验平台结果为准。</view>

</view>
