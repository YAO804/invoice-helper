<view class="page">

  <view class="card">
    <view class="card-t">台账排序</view>
    <view class="tiny muted" style="margin:8rpx 0 18rpx">影响台账列表和导出顺序，默认按录入时间（最新在前）。</view>
    <view class="row sort-bar">
      <view class="sort-btn {{sortBy === 'created' ? 'on' : ''}}" data-sort="created" bindtap="onSortChange" hover-class="btn-hover">录入时间</view>
      <view class="sort-btn {{sortBy === 'number' ? 'on' : ''}}" data-sort="number" bindtap="onSortChange" hover-class="btn-hover">发票号码</view>
      <view class="sort-btn {{sortBy === 'issued' ? 'on' : ''}}" data-sort="issued" bindtap="onSortChange" hover-class="btn-hover">开票日期</view>
      <view class="sort-btn {{sortBy === 'reimburser' ? 'on' : ''}}" data-sort="reimburser" bindtap="onSortChange" hover-class="btn-hover">报销人</view>
    </view>
    <view class="divider"></view>
    <view class="card-t">月份归组口径</view>
    <view class="tiny muted" style="margin:8rpx 0 18rpx">决定台账和统计页按哪个月份分组筛选。</view>
    <view class="row sort-bar">
      <view class="sort-btn {{basis === 'created' ? 'on' : ''}}" data-basis="created" bindtap="onBasisChange" hover-class="btn-hover">按录入月</view>
      <view class="sort-btn {{basis === 'issued' ? 'on' : ''}}" data-basis="issued" bindtap="onBasisChange" hover-class="btn-hover">按开票月</view>
    </view>
  </view>

  <view class="card">
    <view class="card-t">桌面端连接</view>
    <view class="tiny muted" style="margin:8rpx 0 14rpx">手机和电脑连同一个 WiFi 即可自动找到电脑；找不到时再手动填地址。</view>
    <view wx:if="{{canDiscover}}" class="btn btn-block" bindtap="onDiscover" hover-class="btn-hover">{{discovering ? '正在搜索…' : '自动搜索电脑'}}</view>
    <view wx:else class="tiny muted" style="margin-bottom:12rpx">当前微信版本不支持自动搜索，请手动填写地址。</view>
    <view wx:if="{{discoverTip}}" class="tiny muted" style="margin:10rpx 0">{{discoverTip}}</view>
    <input class="input" value="{{desktopUrl}}" bindinput="onDesktopUrlInput" placeholder="http://192.168.1.20:8765" />
    <view class="btn-row" style="margin-top:16rpx">
      <view class="btn" bindtap="onSaveDesktop" hover-class="btn-hover">保存地址</view>
      <view class="btn btn-ghost" bindtap="onTestDesktop" hover-class="btn-hover">测试连接</view>
    </view>
    <view class="tiny muted" style="margin-top:12rpx">状态：{{desktopStatus}}</view>
  </view>

  <view class="card">
    <view class="card-t">数据与备份</view>
    <view class="btn btn-ghost btn-block" style="margin-top:16rpx" bindtap="onExport" hover-class="btn-hover">导出与备份</view>
    <view class="btn btn-grey btn-block" style="margin-top:16rpx" bindtap="onReview" hover-class="btn-hover">待复核（{{reviewCount}}）</view>
    <view class="tiny muted" style="margin-top:14rpx">数据默认只存在这台手机的私有目录，不上传云端；如已配置桌面端，发送文件时会上传到同一局域网的电脑。原件默认保留 30 天，清理前请先导出留底。</view>
  </view>

  <view class="card">
    <view class="card-t">关于</view>
    <view class="tiny muted" style="margin-top:10rpx;line-height:1.8">攒票小匣：个人自用的发票信息采集与本地归档辅助。不自动查验、不判断真伪，真伪以国家税务总局查验平台结果为准。</view>
  </view>

  <view class="card tech">
    <view class="small muted" bindtap="onM0" hover-class="btn-hover">M0 技术验证 ›</view>
  </view>

</view>
