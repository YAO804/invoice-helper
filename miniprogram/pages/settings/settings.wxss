.tech {
  padding: 16rpx 24rpx;
}

/*
 * 状态卡：设置页第一眼要回答「现在能不能收票」。
 * 所以结论用 34rpx 大字，地址与张数降成副行——以前这三样挤在一行 22rpx 里，
 * 用户看过去只记得一排按钮。
 */
.status-card {
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
}

.status-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex: none;
}

.status-title {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.3;
}

/* 地址可能很长，允许折行，别让 IP 被截成一串看不懂的头几位 */
.status-line {
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  opacity: 0.82;
  word-break: break-all;
}

.status-host { font-family: Menlo, Consolas, monospace; }

/* 上一次操作的结果（扫错码、已停止搜索…）：跟在按钮下面，不另开一块 */
.status-tip {
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  opacity: 0.9;
}

/* 未连接用琥珀：这是「还没准备好」，不是错误 */
.t-warn { background: #FAEEDA; color: #854F0B; }
.t-warn .status-dot { background: #BA7517; }

/* 连不上才是出错：地址在，请求通不了 */
.t-bad { background: #FCEBEB; color: #A32D2D; }
.t-bad .status-dot { background: #A32D2D; }

.t-idle { background: #ecece8; color: #444441; }
.t-idle .status-dot { background: #888780; }

/* 已连接用浅绿整块：状态条上可以让位给白底，这里不行——设置页就是来看状态的 */
.t-ok { background: #E1F5EE; color: #0F6E56; }
.t-ok .status-dot { background: #0F6E56; }
