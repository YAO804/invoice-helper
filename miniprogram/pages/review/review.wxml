<view class="page">

  <view class="card">
    <view class="card-t">待复核清单</view>
    <view class="tiny muted" style="margin-top:8rpx">缺号码或有离线异常标记的发票。只提示字段问题，不代表真伪判断。</view>
  </view>

  <view wx:for="{{list}}" wx:key="id" class="card invoice" data-id="{{item.id}}" bindtap="onOpen" hover-class="btn-hover">
    <view class="row">
      <view class="grow">
        <view class="card-t ellipsis">{{item.title}}</view>
        <view class="tiny muted mono" style="margin-top:8rpx">{{item.no}}</view>
      </view>
      <view class="amount-lg">¥{{item.amountText}}</view>
    </view>
    <view class="reasons">
      <view wx:for="{{item.reasons}}" wx:for-item="reason" wx:key="*this" class="reason">· {{reason}}</view>
    </view>
    <view class="row tiny muted" style="margin-top:14rpx">
      <text>{{item.importText}} · 开票 {{item.date}}</text>
      <text>{{item.categoryText}} · {{item.sourceText}}</text>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <view>没有待复核的发票。</view>
    <view>继续保持就好。</view>
  </view>

  <view wx:if="{{!list.length}}" class="card">
    <view class="btn btn-ghost btn-block" bindtap="onCollect" hover-class="btn-hover">去收票</view>
  </view>

</view>
