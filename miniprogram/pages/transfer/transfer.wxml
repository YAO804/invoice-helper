<view class="page">

  <view class="card">
    <view class="row">
      <view class="card-t">传到电脑</view>
      <view class="badge {{connected ? '' : 'badge-grey'}}">{{connected ? '已连接' : '未连接'}}</view>
    </view>
    <view class="tiny muted" style="margin-top:8rpx">{{baseText}}</view>
    <view wx:if="{{!connected}}" class="tiny warn" style="margin-top:14rpx">尚未连接电脑端。请先在「设置」里连上电脑，手机和电脑要在同一 WiFi。</view>
    <view class="divider"></view>
    <view class="btn btn-block" bindtap="onFromChat" hover-class="btn-hover">从微信会话选文件发送</view>
    <view class="tiny muted" style="margin-top:12rpx">先把 .xml / .ofd / .pdf 以「文件」发到文件传输助手，再在这里选。最多 20 个、单个不超过 20MB。</view>
  </view>

  <view class="card">
    <view class="sort-bar">
      <view class="sort-btn {{tab === 'sent' ? 'on' : ''}}" data-tab="sent" bindtap="onTab" hover-class="btn-hover">我的上传 {{history.length}}</view>
      <view class="sort-btn {{tab === 'remote' ? 'on' : ''}}" data-tab="remote" bindtap="onTab" hover-class="btn-hover">电脑已收 {{remoteLoaded ? remote.length : '—'}}</view>
    </view>

    <view class="row tiny muted" style="margin-bottom:6rpx">
      <text>{{tab === 'sent' ? '本机记录，只存在这台手机上' : '电脑端实际收到的文件'}}</text>
      <text wx:if="{{tab === 'remote'}}" bindtap="onRefreshRemote" class="link">{{remoteLoading ? '读取中…' : '刷新'}}</text>
    </view>

    <view wx:if="{{!currentCount}}" class="empty" style="padding:56rpx 20rpx">
      <block wx:if="{{tab === 'sent'}}">还没有上传记录。上传文件后会显示在这里，最多保留 {{retentionDays}} 天。</block>
      <block wx:elif="{{!connected}}">还没有连接电脑。到「设置 → 桌面端连接」连上后再刷新。</block>
      <block wx:else>电脑端还没有收到文件。</block>
    </view>

    <block wx:if="{{tab === 'sent'}}">
      <view wx:for="{{history}}" wx:key="id" class="pick-row" data-id="{{item.id}}" bindtap="onToggle" hover-class="btn-hover">
        <view class="check {{item.checked ? 'on' : ''}}"><text wx:if="{{item.checked}}">✓</text></view>
        <view class="grow" style="margin-left:16rpx">
          <view class="row">
            <text class="small ellipsis grow">{{item.name}}</text>
            <text class="badge {{item.status === 'fail' ? 'badge-warn' : (item.status === 'duplicate' ? 'badge-grey' : '')}}">{{item.statusLabel}}</text>
          </view>
          <view class="tiny muted" style="margin-top:6rpx">{{item.humanSize}} · {{item.sourceLabel}} · {{item.timeText}}</view>
          <view wx:if="{{item.status === 'fail'}}" class="tiny danger" style="margin-top:4rpx">{{item.message}}</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:for="{{remote}}" wx:key="id" class="pick-row" data-id="{{item.id}}" bindtap="onToggle" hover-class="btn-hover">
        <view class="check {{item.checked ? 'on' : ''}}"><text wx:if="{{item.checked}}">✓</text></view>
        <view class="grow" style="margin-left:16rpx">
          <view class="row">
            <text class="small ellipsis grow">{{item.name}}</text>
            <text class="tiny muted">{{item.humanSize}}</text>
          </view>
          <view class="tiny muted" style="margin-top:6rpx">{{item.timeText}} · {{item.source}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="card">
    <view class="row">
      <view class="tiny muted">已选 {{selectedIds.length}} {{noun}}</view>
      <text wx:if="{{currentCount}}" class="link" bindtap="onToggleAll">{{allSelected ? '取消全选' : '全选'}}</text>
    </view>
    <view class="btn-row" style="margin-top:16rpx">
      <view class="btn btn-danger" bindtap="onDeleteSelected" hover-class="btn-hover">删除选中</view>
      <view class="btn btn-grey" bindtap="onDeleteAll" hover-class="btn-hover">全部删除</view>
      <view class="btn btn-ghost" bindtap="onPurgeOld" hover-class="btn-hover">清理超 {{retentionDays}} 天</view>
    </view>
    <view class="tiny muted" style="margin-top:6rpx">
      <block wx:if="{{tab === 'sent'}}">只删本机记录，不动电脑端文件。超过 {{retentionDays}} 天的记录会自动清理。</block>
      <block wx:else>会真的删除电脑上的接收文件，不可恢复。电脑端也会每 6 小时自动清理超过 {{retentionDays}} 天的文件。</block>
    </view>
  </view>

  <view class="foot tiny muted">发送记录只存在本机；电脑端实际收到了什么，以「电脑已收」为准。本工具不查验发票真伪。</view>

</view>
