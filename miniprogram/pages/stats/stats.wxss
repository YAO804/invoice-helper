.summary {
  padding: 24rpx 30rpx;
}

.sum-amount {
  font-size: 56rpx;
  font-weight: 500;
  color: #0f6e56;
  line-height: 1.4;
  margin: 12rpx 0;
}

.bar-row {
  margin-top: 24rpx;
}

.bar-track {
  height: 10rpx;
  background: #ecece8;
  border-radius: 999rpx;
  margin: 10rpx 0 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #0f6e56;
  border-radius: 999rpx;
}

.foot {
  padding: 10rpx 8rpx;
  line-height: 1.7;
}
