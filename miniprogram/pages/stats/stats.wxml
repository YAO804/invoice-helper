<view class="page">

  <view class="card">
    <picker mode="selector" range="{{monthOptions}}" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="picker-box row">
        <text>统计范围：{{currentMonthText}}</text>
        <text class="muted tiny">切换 ›</text>
      </view>
    </picker>
  </view>

  <view class="card summary">
    <view class="row tiny muted"><text>发票张数</text><text>{{count}} 张</text></view>
    <view class="sum-amount">¥ {{totalText}}</view>
  </view>

  <view class="card">
    <view class="card-t">按消费场景</view>
    <view wx:for="{{categories}}" wx:key="name" class="bar-row">
      <view class="row small">
        <text>{{item.name}}</text>
        <text class="amount">¥{{item.amountText}}</text>
      </view>
      <view class="bar-track"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
      <view class="row tiny muted"><text>{{item.count}} 张</text><text>{{item.percent}}%</text></view>
    </view>
    <view wx:if="{{!categories.length}}" class="tiny muted" style="margin-top:16rpx">这个范围还没有发票。</view>
  </view>

  <view class="card">
    <view class="card-t">按来源</view>
    <view wx:for="{{sources}}" wx:key="name" class="bar-row">
      <view class="row small">
        <text>{{item.name}}</text>
        <text class="amount">¥{{item.amountText}}</text>
      </view>
      <view class="bar-track"><view class="bar-fill" style="width:{{item.percent}}%"></view></view>
      <view class="row tiny muted"><text>{{item.count}} 张</text><text>{{item.percent}}%</text></view>
    </view>
    <view wx:if="{{!sources.length}}" class="tiny muted" style="margin-top:16rpx">这个范围还没有发票。</view>
  </view>

  <view class="foot tiny muted">统计只按本机台账计算，金额按价税合计归类，不查验发票真伪。</view>

</view>
